{
  "app": {
    "defaultTheme": "dark",
    "fontVariantLigatures": "normal"
  },
  "typography": {
    "fontSize": 50,
    "lineHeight": 1.15,
    "letterSpacing": 0,
    "padX": 20,
    "padY": 20
  },
  "editor": {
    "content": "",
    "heightFraction": 0.25,
    "fontSize": 20,
    "padX": 12,
    "padY": 12
  },
  "canvas": {
    "width": 1920,
    "height": 1080,
    "font": "Cascadia Code",
    "fontWeight": 400,
    "fitToContent": true
  },
  "export": {
    "defaultThemeFilename": "my-custom-theme",
    "defaultImageFilename": "workspace-capture"
  },
  "theme": {
    "bracket": ["#bb9af7", "#ff9e64", "#7dcfff"],
    "function": "#7aa2f7",
    "variable": "#e0af68",
    "number": "#f7768e",
    "operator": "#89ddff",
    "semicolon": "#444b6a",
    "comment": "#565f89",
    "unknown": "#cfc9c2",
    "background": "#1a1b26"
  }
}
